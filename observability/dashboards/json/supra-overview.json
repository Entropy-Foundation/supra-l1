{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "name": "Epoch change",
        "expr": "(max(supra_lifecycle_epoch_start_timestamp_current{instance=~\"$instance\"}) / 1000) and ((time() - max(supra_lifecycle_epoch_start_timestamp_current{instance=~\"$instance\"}) / 1e6) < ($__interval_ms / 1000 + 30))",
        "step": "",
        "titleFormat": "Epoch change",
        "textFormat": "A new epoch started",
        "tagKeys": "",
        "useValueForTime": true,
        "target": {
          "expr": "(max(supra_lifecycle_epoch_start_timestamp_current{instance=~\"$instance\"}) / 1000) and ((time() - max(supra_lifecycle_epoch_start_timestamp_current{instance=~\"$instance\"}) / 1e6) < ($__interval_ms / 1000 + 30))",
          "refId": "Anno",
          "interval": "",
          "legendFormat": ""
        },
        "filter": {
          "exclude": false,
          "ids": [
            11,
            17,
            20
          ]
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Node restart",
        "expr": "(process_start_time_seconds{instance=~\"$instance\"} * 1000) and ((time() - process_start_time_seconds{instance=~\"$instance\"}) < ($__interval_ms / 1000 + 30))",
        "step": "",
        "titleFormat": "Node restart",
        "textFormat": "{{instance}} (re)started",
        "tagKeys": "",
        "useValueForTime": true,
        "target": {
          "expr": "(process_start_time_seconds{instance=~\"$instance\"} * 1000) and ((time() - process_start_time_seconds{instance=~\"$instance\"}) < ($__interval_ms / 1000 + 30))",
          "refId": "Anno",
          "interval": "",
          "legendFormat": ""
        },
        "filter": {
          "exclude": false,
          "ids": [
            10,
            18,
            19
          ]
        }
      }
    ]
  },
