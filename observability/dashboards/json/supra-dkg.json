        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(supra_dkg_timeout_restarts_total{instance=~\"$instance\"}[$__range])) or vector(0)",
          "refId": "A"
        }
      ],
